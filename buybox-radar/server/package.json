{
  "name": "@radar/server",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed/seed.ts",
    "seed:generate": "tsx scripts/generate-seed.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "@prisma/client": "^5.19.0",
    "zod": "^3.23.0",
    "@radar/shared": "*",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "lru-cache": "^11.0.1",
    "fastest-levenshtein": "^1.0.16"
  },
  "devDependencies": {
    "prisma": "^5.19.0",
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0",
    "supertest": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/cors": "^2.8.17",
    "@types/supertest": "^6.0.2",
    "@faker-js/faker": "^9.0.0"
  }
}
